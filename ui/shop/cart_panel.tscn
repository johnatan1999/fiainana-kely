[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://ui/shop/cart_panel.gd" id="1_cartpanel"]

[node name="CartPanel" type="PanelContainer"]
custom_minimum_size = Vector2(220, 0)
script = ExtResource("1_cartpanel")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 2
theme_override_constants/margin_left = 10
theme_override_constants/margin_top = 10
theme_override_constants/margin_right = 10
theme_override_constants/margin_bottom = 10

[node name="VBox" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 6

[node name="TitleLabel" type="Label" parent="Margin/VBox"]
layout_mode = 2
text = "Panier — Sobika"
horizontal_alignment = 1

[node name="CartScroll" type="ScrollContainer" parent="Margin/VBox"]
custom_minimum_size = Vector2(0, 260)
layout_mode = 2
size_flags_vertical = 3
horizontal_scroll_mode = 0

[node name="CartList" type="VBoxContainer" parent="Margin/VBox/CartScroll"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3

[node name="EmptyLabel" type="Label" parent="Margin/VBox"]
unique_name_in_owner = true
layout_mode = 2
text = "Panier vide"
horizontal_alignment = 1
modulate = Color(1, 1, 1, 0.6)

[node name="TotalLabel" type="Label" parent="Margin/VBox"]
unique_name_in_owner = true
layout_mode = 2
text = "Total: 0 $"
horizontal_alignment = 1

[node name="CheckoutButton" type="Button" parent="Margin/VBox"]
unique_name_in_owner = true
layout_mode = 2
focus_mode = 0
disabled = true
text = "Confirmer l'achat"
