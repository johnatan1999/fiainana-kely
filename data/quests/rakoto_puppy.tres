[gd_resource type="Resource" script_class="Quest" load_steps=5 format=3]

[ext_resource type="Script" path="res://core/data/quest.gd" id="1_quest"]
[ext_resource type="Script" path="res://core/data/quest_step.gd" id="2_step"]

[sub_resource type="Resource" id="Step_ask"]
script = ExtResource("2_step")
kind = 0
objective = "Demande à Neny si tu peux ramener un chiot à la maison."
villager = "mother"
prompt = "Parler du chiot à Neny"
line = "Un chien ? ... Bon, d'accord. Mais c'est toi qui rempliras sa gamelle, tous les jours ! Un chien qui a le ventre vide va chercher sa pitance ailleurs, et ne garde rien du tout."

[sub_resource type="Resource" id="Step_choose"]
script = ExtResource("2_step")
kind = 3
objective = "Va choisir ton chiot dans le panier, devant la case de Rakoto."
target = "puppy_basket"
prompt = "Choisir un chiot"
line = "Un chiot te mordille les doigts, puis se blottit contre toi. C'est lui ! Il ne te quitte plus d'une semelle."

[resource]
script = ExtResource("1_quest")
title = "Le chiot de Rakoto"
giver = "rakoto"
offer_line = "Ma chienne Vony a eu des petits ! Je ne peux pas tous les garder... Avec les voleurs de poules qui rôdent, un chien à la ferme, ça veille mieux qu'un cadenas. Et ça tient compagnie ! Demande d'abord à ta mère, hein."
min_day = 8
after_quests = Array[String](["rakoto_lost_zebu"])
steps = Array[ExtResource("2_step")]([SubResource("Step_ask"), SubResource("Step_choose")])
reward_friendship = 50
reward_unlock = "dog"
reward_unlock_label = "un chiot"
evening_speaker = "fara"
evening_line = "Je n'ai pas lâché le chiot de la soirée ! Il a déjà choisi sa place : devant la porte, pour garder la maison."
