[ext_resource type="Script" path="res://core/data/discovery.gd" id="1_discovery"]

[resource]
script = ExtResource("1_discovery")
category = 2
display_name = "Le vieil amontana"
malagasy_name = "Amontana"
description = "Un figuier géant, plus vieux que le village. On le respecte : on n'y coupe rien, et on y dépose parfois une offrande."
hint = "Le plus grand arbre de la forêt."
fara_line = "Dada dit qu'il faut lui dire bonjour en passant."
